<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Contactless payment card, gently tilted for a "tap" feel. Kept within the adaptive-icon
         safe zone (central ~66dp). -->
    <group
        android:name="card"
        android:rotation="-8"
        android:pivotX="54"
        android:pivotY="54">

        <!-- card body -->
        <path
            android:pathData="M32,37 L76,37 A4,4 0 0 1 80,41 L80,67 A4,4 0 0 1 76,71 L32,71 A4,4 0 0 1 28,67 L28,41 A4,4 0 0 1 32,37 Z"
            android:strokeColor="#40FFF3D6"
            android:strokeWidth="0.6">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="30"
                    android:startY="37"
                    android:endX="78"
                    android:endY="71">
                    <item android:offset="0.0" android:color="#FFFFEAC4" />
                    <item android:offset="0.5" android:color="#FFFDC85A" />
                    <item android:offset="1.0" android:color="#FFF3AC17" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- EMV chip -->
        <path
            android:pathData="M35.8,46.5 L43.2,46.5 A1.8,1.8 0 0 1 45,48.3 L45,54.2 A1.8,1.8 0 0 1 43.2,56 L35.8,56 A1.8,1.8 0 0 1 34,54.2 L34,48.3 A1.8,1.8 0 0 1 35.8,46.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="34"
                    android:startY="46.5"
                    android:endX="45"
                    android:endY="56">
                    <item android:offset="0.0" android:color="#FFE6A52A" />
                    <item android:offset="1.0" android:color="#FFB87D0C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- chip contacts -->
        <path
            android:pathData="M34,51.25 L45,51.25 M39.5,46.5 L39.5,56"
            android:fillColor="#00000000"
            android:strokeColor="#D94A3208"
            android:strokeWidth="1"
            android:strokeLineCap="round" />

        <!-- contactless waves -->
        <path
            android:pathData="M56,49 Q60,54 56,59 M60,46.5 Q66,54 60,61.5 M64,44 Q72,54 64,64"
            android:fillColor="#00000000"
            android:strokeColor="#FF4A3208"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
    </group>
</vector>
